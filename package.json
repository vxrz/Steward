{
  "name": "service-manager",
  "private": true,
  "version": "0.1.0",
  "description": "Local service & platform management tool for Insights Hub, Industrial Edge and any REST platform",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "demo": "npm run build && cross-env SM_DEMO=1 npm run start -w server",
    "test": "npm run test -w server",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web",
    "dev:demo": "cross-env SM_DEMO=1 node scripts/dev.mjs",
    "validate": "tsx server/src/cli/validate.ts"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tinypool": "~2.2.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "tinypool": "$tinypool"
  }
}
