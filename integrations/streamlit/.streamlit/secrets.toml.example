# Copy to .streamlit/secrets.toml (ignored by Git) and fill in. Never commit the real file.
# In Docker, mount it read-only at /app/.streamlit/secrets.toml (compose.snippet.yml).

[steward]
# Steward's address, with the base path if Steward runs under one (SM_PUBLIC_URL), without /api/v1.
#   own host name:       "https://steward.corp.example"
#   under a path:        "https://apps.corp.example/steward"
#   same Docker network: "http://steward:4310/steward"   (add "steward" to SM_ALLOWED_HOSTS)
base_url = "https://steward.corp.example"
# Read-only API token of a dedicated technical user (Profile → API tokens → New token, scope "Read only").
token = "<read-only token, starts with smt_>"
# Optional: CA bundle (PEM) when Steward's certificate comes from a company CA.
# ca_bundle = "/app/.streamlit/corp-ca.pem"

# Optional: sign-in with Streamlit's OpenID Connect login (st.login). Remove the section to turn it off.
# [auth]
# redirect_uri = "https://apps.corp.example/dashboards/oauth2callback"
# cookie_secret = "<random string: python -c 'import secrets; print(secrets.token_urlsafe(32))'>"
# client_id = "<client id registered at your identity provider>"
# client_secret = "<client secret>"
# server_metadata_url = "https://login.corp.example/.well-known/openid-configuration"

# Optional: only these accounts may use the app (checked after the sign-in).
# [access]
# allowed_emails = ["alice@corp.example", "bob@corp.example"]
